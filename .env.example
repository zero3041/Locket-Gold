# Core bot deployment
BOT_TOKEN=
ADMIN_ID=
NEXTDNS_KEYS=
NUM_WORKERS=2
# JSON array of activation-provider credential objects. Keep it in a secret store.
TOKEN_SETS_JSON=
REVENUECAT_APP_KEY=

# Payment credentials (required for /muacdk)
SEPAY_API_TOKEN=
BANK_BIN=
BANK_ACCOUNT=
BANK_NAME=
BANK_OWNER=

# One CDK price in VND. Quantity 1-5 is multiplied by this value.
CDK_UNIT_PRICE=0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this stable. Changing it invalidates HMAC lookup for secure CDKs.
CDK_SECRET=

# Optional tuning
CDK_ORDER_TIMEOUT_MINUTES=20
SEPAY_POLL_INTERVAL_SECONDS=30
CDK_ORDER_CREATE_MAX=3
CDK_ORDER_CREATE_WINDOW_SECONDS=300
CDK_MANUAL_CHECK_MAX=3
CDK_MANUAL_CHECK_WINDOW_SECONDS=60
SEPAY_GLOBAL_CHECK_MAX=60
SEPAY_GLOBAL_CHECK_WINDOW_SECONDS=60
SEPAY_MAX_ORDERS_PER_POLL=20
CDK_RESERVATION_TTL_SECONDS=21600
# Telegram file IDs are not API secrets, but ENV keeps deployment config together.
DONATE_PHOTO=
VIDEO_FILE_ID=

# Web store (web_store.py) — separate sales front + admin panel
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ADMIN_USER=admin
# Preferred: PBKDF2-SHA256 hash in the form pbkdf2$iterations$salt_b64$hash_b64.
# Generate with: python3 -c "import base64,hashlib,secrets;pw='YOUR_PASSWORD';s=secrets.token_bytes(16);h=hashlib.pbkdf2_hmac('sha256',pw.encode(),s,210000);print('pbkdf2$210000$%s$%s'%(base64.urlsafe_b64encode(s).decode().rstrip('='),base64.urlsafe_b64encode(h).decode().rstrip('=')))"
WEB_ADMIN_PASSWORD_HASH=
# Legacy fallback only — plaintext, avoid when WEB_ADMIN_PASSWORD_HASH is set.
WEB_ADMIN_PASSWORD=
# Optional; falls back to CDK_SECRET when unset. Keep stable across restarts.
WEB_SESSION_SECRET=
