# Core bot deployment
BOT_TOKEN=
ADMIN_ID=
# RevenueCat secret key (Bearer token) used for status checks and alias activation.
REVENUECAT_APP_KEY=

# Payment credentials (required to sell keys in the bot and on the web store)
SEPAY_API_TOKEN=
BANK_BIN=
BANK_ACCOUNT=
BANK_NAME=
BANK_OWNER=

# Key price in VND for the permanent plan sold on the web/bot.
# CDK_UNIT_PRICE_1Y is only used for admin-issued 1-year keys (optional).
CDK_UNIT_PRICE=0
CDK_UNIT_PRICE_1Y=0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this stable. Changing it invalidates HMAC lookup for secure keys.
CDK_SECRET=

# Optional tuning
CDK_ORDER_TIMEOUT_MINUTES=20
SEPAY_POLL_INTERVAL_SECONDS=30
CDK_ORDER_CREATE_MAX=3
CDK_ORDER_CREATE_WINDOW_SECONDS=300
CDK_MANUAL_CHECK_MAX=3
CDK_MANUAL_CHECK_WINDOW_SECONDS=60
SEPAY_GLOBAL_CHECK_MAX=60
SEPAY_GLOBAL_CHECK_WINDOW_SECONDS=60
SEPAY_MAX_ORDERS_PER_POLL=20
CDK_RESERVATION_TTL_SECONDS=21600

# Source pool / bulk check / scan tuning
# A source is ignored and cleaned up when its Gold has fewer than this many days.
GOLD_MIN_SOURCE_DAYS=10
# Free re-activation on the web store (UIDs activated before).
FREE_REACTIVATE_COOLDOWN_MINUTES=30
FREE_REACTIVATE_DAILY_MAX=5
CHK_MAX_LINES=500
SCAN_MAX_COMMENTS=1000
SCAN_MAX_CONCURRENT=2
CHECK_MAX_CONCURRENT=4

# Optional HTTP(S) proxy used only for /chk bulk lookups (keeps the bot IP clean).
CHK_PROXY_URL=

# Optional outbound proxy for reaching Telegram when the direct route is blocked.
# e.g. http://127.0.0.1:1080 or socks5://user:pass@host:port
PROXY_URL=

# Telegram file IDs are not API secrets, but ENV keeps deployment config together.
DONATE_PHOTO=
VIDEO_FILE_ID=

# Web store (web_store.py) — separate sales front + admin panel
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ADMIN_USER=admin
# Preferred: PBKDF2-SHA256 hash in the form pbkdf2$iterations$salt_b64$hash_b64.
# Generate with: python3 -c "import base64,hashlib,secrets;pw='YOUR_PASSWORD';s=secrets.token_bytes(16);h=hashlib.pbkdf2_hmac('sha256',pw.encode(),s,210000);print('pbkdf2$210000$%s$%s'%(base64.urlsafe_b64encode(s).decode().rstrip('='),base64.urlsafe_b64encode(h).decode().rstrip('=')))"
WEB_ADMIN_PASSWORD_HASH=
# Legacy fallback only — plaintext, avoid when WEB_ADMIN_PASSWORD_HASH is set.
WEB_ADMIN_PASSWORD=
# Optional; falls back to CDK_SECRET when unset. Keep stable across restarts.
WEB_SESSION_SECRET=
